---
import Layout from "../layouts/Layout.astro";
// TODO: replace with the real links
const applyUrl = "#";
const base = "https://startupmission.kerala.gov.in";
const nav = [
  { label: "Home", href: "/" },
  { label: "Startups", href: base },
  { label: "Programs", href: base },
  { label: "Ecosystem", href: base },
  { label: "Notifications", href: base },
  { label: "Search", href: base },
];
const cards = [
  { key: "edp", no: "1", theme: "blue", wide: true, title: "Entrepreneurship Development Programme", summary: "Dedicated Entrepreneurship Development Programmes designed to strengthen the entrepreneurial capabilities of social and rural enterprises through training in idea validation, business planning, financial management, branding, market access and digital enablement." },
  { key: "ric", no: "2", theme: "orange", title: "Rural Incubation Centres (RIC)", summary: "3 Zonal hubs across North, Central, and South Kerala delivering regional infrastructure, local domain expertise, and industry linkage." },
  { key: "sip", no: "3", theme: "green", title: "Social Incubation Programme (SIP)", summary: "A structured 6-month intensive cohort programme delivering curated support to 15 potential social/ rural innovators or entrepreneurs who will be fed into an Incubation Programme." },
  { key: "sprint", no: "4", theme: "blue", title: "Foundational Sprint Course & Evaluation", summary: "A 2-week intensive online/offline boot camp covering Design Thinking, Market Research, and Business Modelling." },
  { key: "mentor", no: "5", theme: "orange", title: "Incubation Support & Mentorship", summary: "Personalized domain mentorship coordinated by Innovation Ambassadors & sector experts across technical, legal, and business strategies." },
  { key: "ipr", no: "6", theme: "green", title: "IPR, Tech Transfer & Quality Certification", summary: "Facilitation of Patent filings, Geographical Indications (GI), Technology Transfers, and ZED Quality Certifications." },
  { key: "fund", no: "7", theme: "gold", wide: true, title: "Phased Funding Support (Up to ₹5 Lakhs)", summary: "Milestone-linked financial grant released in 2-3 installments during the 6-month incubation period." },
];
---
<Layout title="Social Entrepreneurship Programme | Kerala Startup Mission">
<!-- NAVIGATION -->
<header id="site-header" class="site-header sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10 h-[72px] flex items-center justify-between">
    <a href="/" class="flex items-center shrink-0"><img src="/img/logo.svg" class="w-24 md:w-28" alt="Kerala Startup Mission"></a>
    <nav class="hidden lg:flex items-center gap-7 text-[13px] font-semibold text-body">
      {nav.map((n) => <a href={n.href} class="nav-link">{n.label}</a>)}
    </nav>
    <div class="flex items-center gap-3">
      <a href={applyUrl} class="btn-primary hidden sm:inline-flex">Apply <span>→</span></a>
      <button id="mobile-menu-btn" type="button" class="mobile-menu-btn lg:hidden flex" aria-label="Open menu"><span></span><span></span></button>
    </div>
  </div>
  <div id="mobile-menu" class="mobile-menu lg:hidden">
    <nav class="flex flex-col">
      {nav.map((n) => <a href={n.href} class="mobile-nav-link">{n.label}</a>)}
    </nav>
    <div class="mt-6 pt-5 border-t border-line"><a href={applyUrl} class="btn-primary">Apply →</a></div>
  </div>
</header>

<!-- HERO -->
<section id="top" class="hero3">
  <div class="hero3-dots"></div>
  <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10 relative">
    <div class="hero3-grid">
      <div class="hero3-main">
        <p class="hero3-eyebrow"><i></i>Kerala Startup Mission</p>
        <h1 class="hero3-title">Social <br>Entrepreneurship <span>Programme</span></h1>
        <p class="hero3-lead">Kerala Startup Mission is working towards creating a vibrant and sustainable social entrepreneurship ecosystem in Kerala by enabling enterprises that combine innovation with meaningful social impact.</p>
        <div class="hero3-actions">
          <a href={applyUrl} class="btn-primary btn-large">Apply <span>→</span></a>
          <a href="#overview" class="hero3-link">Program Overview ↓</a>
        </div>
      </div>
      <!-- decorative growth illustration -->
      <div class="hero3-art" aria-hidden="true">
        <svg viewBox="0 0 460 460" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="230" cy="230" r="215" stroke="rgba(255,255,255,.14)" stroke-dasharray="3 9"/>
          <circle cx="230" cy="230" r="160" stroke="rgba(255,255,255,.18)"/>
          <circle cx="230" cy="230" r="105" fill="rgba(183,227,74,.12)"/>
          <path d="M230 370V210" stroke="#B7E34A" stroke-width="6" stroke-linecap="round"/>
          <path d="M230 285C230 240 190 215 150 220C150 262 185 290 230 285Z" fill="#B7E34A"/>
          <path d="M230 240C230 195 268 165 312 170C312 215 275 245 230 240Z" fill="#FFB627"/>
          <path d="M230 210C230 178 246 150 230 122C214 150 230 178 230 210Z" fill="#fff"/>
          <path d="M120 372Q230 340 340 372" stroke="rgba(255,255,255,.35)" stroke-width="3" stroke-linecap="round"/>
          <circle cx="82" cy="150" r="9" fill="#FF6B4A"/><circle cx="392" cy="120" r="6" fill="#FFB627"/><circle cx="405" cy="300" r="11" stroke="#B7E34A" stroke-width="3"/><circle cx="60" cy="300" r="5" fill="#fff"/>
        </svg>
        <span class="float-chip chip-a">3 Zonal Hubs</span>
        <span class="float-chip chip-b">6-Month Cohort</span>
        <span class="float-chip chip-c">Up to ₹5 Lakhs</span>
      </div>
    </div>
    <div class="hero3-strip">
      {cards.map((c) => (
        <a href={`#card-${c.key}`} class="hero3-tile"><span>{c.no}</span><strong>{c.title}</strong></a>
      ))}
    </div>
  </div>
  <svg class="hero3-wave" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true"><path d="M0 40C240 80 480 0 720 30S1200 75 1440 25V70H0Z" fill="#fff"/></svg>
</section>

<!-- PROGRAM OVERVIEW -->
<section id="overview" class="section-white py-20 overview">
  <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10">
    <div class="mb-10">
      <p class="section-eyebrow"><i></i>Program Overview</p>
    </div>
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start">
      <p class="about-lead">Kerala Startup Mission is working towards creating a vibrant and sustainable social entrepreneurship ecosystem in Kerala by enabling enterprises that combine innovation with meaningful social impact. The Social Entrepreneurship Programme (SEP) provides a structured support system to help social enterprises build capabilities, access incubation and explore pathways for growth.</p>
      <p class="body-copy">The programme brings together Entrepreneurship Development Programmes(EDP), Rural Incubation Centres(RIC), Social Incubation Programmes,Program Linked Capital support( Upto 5lakhs), CSR and impact investment networks. Through initiatives such as the Impact Investors Network Kerala (IINK) and the Virtual Social Enterprise Facilitation Centre, SEP connects social entrepreneurs with the knowledge, resources, networks and opportunities required to develop sustainable enterprises and create lasting social impact.</p>
    </div>
    <div class="mt-10"><a href={applyUrl} class="btn-primary btn-large">Apply <span>→</span></a></div>
  </div>
</section>

<!-- CARDS -->
<section id="programs" class="section-soft initiatives-section py-20">
  <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10 relative">
    <div class="bento">
      {cards.map((c) => (
        <article id={`card-${c.key}`} class={`initiative-card initiative-${c.theme} ${c.wide ? "is-wide" : ""}`}>
          <svg class="card-deco" viewBox="0 0 120 120" fill="none" aria-hidden="true"><circle cx="60" cy="60" r="58" stroke="currentColor" stroke-dasharray="2 7"/><circle cx="60" cy="60" r="34" stroke="currentColor"/><circle cx="60" cy="60" r="10" fill="currentColor"/></svg>
          <span class="initiative-no">{c.no}</span>
          <h3>{c.title}</h3>
          <p>{c.summary}</p>
          <button class="initiative-action" data-initiative-modal={c.key}>
            <span>View More</span><span class="initiative-arrow">→</span>
          </button>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- MODAL -->
<div id="initiative-modal" class="initiative-modal" aria-hidden="true">
  <button class="initiative-modal-backdrop" data-modal-close aria-label="Close modal"></button>
  <div id="initiative-modal-dialog" class="initiative-modal-dialog overflow-y-auto scrollbar-hide" role="dialog" aria-modal="true" aria-labelledby="initiative-modal-title" tabindex="-1">
    <div class="initiative-modal-header">
      <h3 id="initiative-modal-title"></h3>
      <button type="button" class="initiative-modal-close" data-modal-close aria-label="Close popup">×</button>
    </div>
    <div class="initiative-modal-inner">
      <div id="initiative-modal-body" class="initiative-modal-body"></div>
    </div>
  </div>
</div>

<!-- FOOTER -->
<footer class="border-t border-line py-8 text-black" id="contact">
  <div class="mx-auto flex max-w-[1180px] items-center justify-between gap-6 px-8 max-[640px]:flex-col max-[640px]:items-start max-[640px]:px-5">
    <a href="/" aria-label="Kerala Startup Mission"><img src="/img/logo.svg" alt="Kerala Startup Mission" class="h-16 w-auto object-contain" /></a>
    <p class="text-xs text-black">© 2026 <a href="https://startupmission.kerala.gov.in/" target="_blank">Kerala Startup Mission.</a> All rights reserved.</p>
  </div>
</footer>

<button id="scrollToTop" type="button" aria-label="Move to top"
  class="fixed bottom-6 right-6 z-50 flex h-12 w-12 translate-y-4 items-center justify-center rounded-full border border-white/20 bg-[#0B3B3C]/90 text-white opacity-0 shadow-[0_12px_30px_rgba(0,0,0,0.25)] backdrop-blur-md transition-all duration-300 hover:-translate-y-1 hover:bg-[#FF6B4A] pointer-events-none">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true"><path d="M18 15l-6-6-6 6"></path></svg>
</button>

<script>
  const btn = document.getElementById("scrollToTop");
  window.addEventListener("scroll", () => {
    const s = window.scrollY > 400;
    btn.classList.toggle("opacity-0", !s);
    btn.classList.toggle("translate-y-4", !s);
    btn.classList.toggle("pointer-events-none", !s);
    btn.classList.toggle("opacity-100", s);
    btn.classList.toggle("translate-y-0", s);
    btn.classList.toggle("pointer-events-auto", s);
  });
  btn.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
</script>
<script is:inline>
  const mb = document.getElementById('mobile-menu-btn');
  const mm = document.getElementById('mobile-menu');
  mb?.addEventListener('click', () => { mb.classList.toggle('active'); mm?.classList.toggle('open'); });

  const initiativeData = {
    edp: { theme: "blue", title: "Entrepreneurship Development Programme",
      body: `<p>Kerala Startup Mission will conduct dedicated Entrepreneurship Development Programmes (EDPs) tailored to the unique needs of social and rural enterprises.</p>
      <p><em>The EDP curriculum provides structured intervention across five critical dimensions:</em></p>
      <p><strong>Idea Validation &amp; Impact Assessment:</strong> Assessing whether the venture solves a genuine social, economic, or environmental challenge while verifying local market demand.</p>
      <p><strong>Financial Management &amp; Sustainability:</strong> Training on basic bookkeeping, unit economics, working capital management, and cost-structure optimization.</p>
      <p><strong>Branding &amp; Value Proposition:</strong> Developing a distinct brand narrative that communicates both the commercial value and the social impact of the product or service</p>
      <p><strong>Market Access &amp; Distribution Strategy:</strong> Formulating localized and regional distribution channels, buyer linkage, and procurement strategies.</p>
      <p><strong>Digital Enablement:</strong> Training founders on digital payment integration, basic e-commerce setups, social media marketing, and ERP tools.</p>` },
    ric: { theme: "orange", title: "Rural Incubation Centres (RIC)",
      body: `<h4>A. Regional Hub Architecture</h4>
      <p>To overcome geographic centralization and bring incubation support directly to grassroots innovators, KSUM facilitates the establishment of three <strong>Zonal Rural Business Incubation Centres (RICs)</strong>:</p>
      <ul><li><strong>North Zone Rural Incubation Centres (RIC)</strong></li><li><strong>Central Zone Rural Incubation Centres (RIC)</strong></li><li><strong>South Zone Rural Incubation Centres (RIC)</strong></li></ul>
      <h4>B. Collaborative Operating Framework</h4>
      <p>Each Rural Incubation Centre operates under a co-location model:</p>
      <ul><li><strong>Host Partners:</strong> Established in physical partnership with local academic institutions, non-governmental organizations (NGOs), or specialized government facilities with proven expertise in livelihoods, agriculture, or rural development.</li>
      <li><strong>Resource Optimization:</strong> Rather than incurring capital expenditure on new real estate, RICs utilize existing public infrastructure to optimize public funds, manpower, and operational overheads.</li>
      <li><strong>Domain-Specific Support:</strong> Delivers specialized workspace, meeting facilities, local testing environments, and hands-on business advisory tailored to regional livelihood strengths</li></ul>` },
    sip: { theme: "green", title: "Social Incubation Programme (SIP)",
      body: `<p>A structured 6-month cohort programme providing customized incubation support to 15 selected social and rural startups.</p>
      <p><strong>Key Features:</strong></p>
      <ul><li>Tailored approach providing sector-specific interventions for each founder.</li>
      <li>Guaranteed focus on supporting <strong>women-led social enterprises</strong> per cohort through funding, mentoring, and enterprise development.</li>
      <li>Dedicated mentor pool of experienced practitioners, sector experts, and impact ecosystem stakeholders.</li>
      <li>Initial KSUM support team to guide participants through available schemes, connections, and opportunities.</li>
      <li>Practical exposure including internships with established social enterprises.</li>
      <li>Leadership development and emotional resilience training tailored to longer scaling timelines.</li></ul>` },
    sprint: { theme: "blue", title: "Foundational Sprint Course & Evaluation",
      body: `<ul><li><strong>Delivery:</strong> A 2-week foundational EDP training delivered online and offline in collaboration with expert partner organizations.</li>
      <li><strong>Core Curriculum:</strong> Introduces fundamental concepts including Design Thinking, Market Research, and Business Modelling.</li>
      <li><strong>Evaluation &amp; Pitch:</strong> Candidates and their ideas are evaluated for commitment and viability. Startups construct a Business Model Canvas (BMC) or Pitch Deck, which serves as the criteria for identifying grant beneficiaries.</li></ul>` },
    mentor: { theme: "orange", title: "Incubation Support & Mentorship",
      body: `<ul><li><strong>Personalized Guidance:</strong> Incubatees receive domain-specific personal mentorship starting within 3 months of enrollment for continuous, context-driven support.</li>
      <li><strong>Role of Innovation Ambassadors:</strong> Connect incubatees with mentors, domain experts, and external institutions to drive product refinement and scaling.</li>
      <li><strong>Scope:</strong> Covers Technical refinement, Legal compliance, Branding, Marketing, and Overall Business Strategy.</li></ul>` },
    ipr: { theme: "green", title: "IPR, Tech Transfer & Quality Certification",
      body: `<ul><li><strong>IPR &amp; GI Support:</strong> Facilitates Intellectual Property Rights (IPR), Geographical Indications (GI), and technology transfer for social enterprises.</li>
      <li><strong>Quality Certification Alignment:</strong> Connects startups to state and central schemes that reimburse costs for IPR, technology transfers, or quality benchmarks (e.g., ZED certifications).</li>
      <li><strong>Product Refinement:</strong> Integrated mentorship and market access support to align product quality with commercial standards.</li></ul>` },
    fund: { theme: "gold", title: "Phased Funding Support (Up to ₹5 Lakhs)",
      body: `<ul><li><strong>Grant Allocation:</strong> Performing incubatees receive financial assistance up to ₹5 Lakhs.</li>
      <li><strong>Instalment Tranches:</strong>
        <ul><li><strong>1st Instalment:</strong> Released after the first pitch upon completion of the 2-week EDP.</li>
        <li><strong>2nd Instalment:</strong> Released following an interim performance review at 3 months, linked to defined product development milestones.</li>
        <li><strong>Final Release:</strong> Disbursed after a final performance review verifying completion of project milestones.</li></ul></li>
      <li><strong>Market Access Support:</strong> Startups completing product development are supported in initial market access through KSUM networks and buyer programmes.</li></ul>` }
  };
  const modal = document.getElementById('initiative-modal');
  const dialog = document.getElementById('initiative-modal-dialog');
  let lastFocus = null;
  function openModal(key){
    const d = initiativeData[key];
    if(!d || !modal) return;
    lastFocus = document.activeElement;
    document.getElementById('initiative-modal-title').textContent = d.title;
    document.getElementById('initiative-modal-body').innerHTML = d.body;
    modal.classList.remove('theme-blue','theme-orange','theme-green','theme-gold');
    modal.classList.add(`theme-${d.theme}`, 'is-open');
    modal.setAttribute('aria-hidden','false');
    document.body.classList.add('modal-open');
    requestAnimationFrame(() => dialog?.focus());
  }
  function closeModal(){
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden','true');
    document.body.classList.remove('modal-open');
    if(lastFocus instanceof HTMLElement) lastFocus.focus();
  }
  document.querySelectorAll('[data-initiative-modal]').forEach((b) => b.addEventListener('click', () => openModal(b.getAttribute('data-initiative-modal'))));
  document.querySelectorAll('[data-modal-close]').forEach((b) => b.addEventListener('click', closeModal));
  document.addEventListener('keydown', (e) => { if(e.key === 'Escape' && modal.classList.contains('is-open')) closeModal(); });
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700;800&family=DM+Sans:wght@400;500;700&display=swap');
  :root{--teal:#0b3b3c;--teal-mid:#0f5a55;--teal-tint:#e3f1ee;--coral:#ff6b4a;--coral-dark:#e0502f;--coral-soft:#ffeae4;--leaf:#b7e34a;--leaf-deep:#3f7d12;--leaf-soft:#f0f9dc;--gold:#ffb627;--gold-soft:#fff3d6;--ink:#0d1f1f;--body:#4d5f5d;--line:#dde7e4;--soft:#f4f8f6;}
  html{scroll-behavior:smooth;}
  body{margin:0;background:#fff;color:var(--ink);font-family:'DM Sans',sans-serif;-webkit-font-smoothing:antialiased;}
  body.modal-open{overflow:hidden;}
  button{font:inherit;cursor:pointer;}
  a:focus-visible,button:focus-visible{outline:3px solid var(--gold);outline-offset:3px;}
  .text-body{color:var(--body);} .border-line{border-color:var(--line);}
  .site-header{background:rgba(255,255,255,.9);border-bottom:1px solid var(--line);backdrop-filter:blur(18px);}
  .nav-link{position:relative;transition:.2s ease;}
  .nav-link::after{content:"";position:absolute;left:0;bottom:-8px;width:0;height:3px;border-radius:999px;background:var(--coral);transition:.25s ease;}
  .nav-link:hover{color:var(--teal);} .nav-link:hover::after{width:100%;}
  .btn-primary{display:inline-flex;align-items:center;gap:.6rem;padding:.72rem 1.25rem;border-radius:999px;background:var(--coral);color:#fff;font-size:.83rem;font-weight:700;box-shadow:0 6px 0 var(--coral-dark);transition:.15s ease;}
  .btn-primary:hover{transform:translateY(3px);box-shadow:0 3px 0 var(--coral-dark);}
  .btn-large{min-height:52px;padding:.95rem 1.65rem;font-size:.92rem;}
  .mobile-menu-btn{width:42px;height:42px;border:1px solid var(--line);border-radius:999px;flex-direction:column;justify-content:center;align-items:center;gap:6px;background:#fff;}
  .mobile-menu-btn span{width:17px;height:1.5px;background:var(--ink);transition:.25s ease;}
  .mobile-menu-btn.active span:first-child{transform:translateY(3.75px) rotate(45deg);}
  .mobile-menu-btn.active span:last-child{transform:translateY(-3.75px) rotate(-45deg);}
  .mobile-menu{display:none;padding:1rem 1.5rem 1.5rem;background:#fff;border-top:1px solid var(--line);box-shadow:0 20px 40px rgba(8,15,35,.08);}
  .mobile-menu.open{display:block;}
  .mobile-nav-link{padding:.8rem 0;border-bottom:1px solid #eef3f1;font-size:.95rem;font-weight:700;color:var(--ink);}
  /* HERO */
  .hero3{position:relative;overflow:hidden;padding:clamp(3.5rem,7vw,6rem) 0 7rem;background:radial-gradient(circle at 85% 20%,var(--teal-mid),transparent 55%),var(--teal);color:#fff;}
  .hero3-dots{position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,.16) 1.2px,transparent 1.2px);background-size:26px 26px;mask-image:linear-gradient(115deg,#000 0,transparent 55%);-webkit-mask-image:linear-gradient(115deg,#000 0,transparent 55%);}
  .hero3-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:2rem;align-items:center;}
  .hero3-eyebrow{display:inline-flex;align-items:center;gap:.6rem;margin:0 0 1.4rem;padding:.45rem 1rem;border-radius:999px;background:rgba(255,255,255,.1);font-size:.8rem;font-weight:700;color:#fff;}
  .hero3-eyebrow i,.section-eyebrow i{width:9px;height:9px;border-radius:50%;background:var(--leaf);display:inline-block;}
  .hero3-title{margin:0;font-family:'Bricolage Grotesque',sans-serif;font-size:clamp(2.5rem,6vw,5.2rem);line-height:1;letter-spacing:-.04em;font-weight:800;}
  .hero3-title span{display:inline-block;margin-top:.15em;color:var(--teal);background:var(--leaf);padding:0 .22em .06em;border-radius:.18em;transform:rotate(-1.5deg);}
  .hero3-lead{max-width:600px;margin:1.8rem 0 0;font-size:clamp(.95rem,1.5vw,1.1rem);line-height:1.75;color:rgba(255,255,255,.82);}
  .hero3-actions{display:flex;flex-wrap:wrap;align-items:center;gap:1.6rem;margin-top:2.2rem;}
  .hero3-link{font-size:.9rem;font-weight:700;color:#fff;border-bottom:2px solid var(--gold);padding-bottom:2px;transition:.2s ease;}
  .hero3-link:hover{color:var(--gold);}
  .hero3-art{position:relative;max-width:440px;width:100%;justify-self:center;}
  .hero3-art svg{width:100%;height:auto;display:block;animation:spinSlow 90s linear infinite;}
  .hero3-art svg{animation:none;}
  .float-chip{position:absolute;padding:.5rem .95rem;border-radius:999px;font-size:.78rem;font-weight:700;color:var(--ink);box-shadow:0 10px 24px rgba(0,0,0,.2);animation:bob 5s ease-in-out infinite;}
  .chip-a{top:8%;left:-4%;background:var(--leaf);}
  .chip-b{top:46%;right:-6%;background:#fff;animation-delay:-1.5s;}
  .chip-c{bottom:10%;left:2%;background:var(--gold);animation-delay:-3s;}
  @keyframes bob{50%{transform:translateY(-10px);}}
  .hero3-strip{display:grid;grid-template-columns:repeat(7,1fr);gap:.8rem;margin-top:3.5rem;}
  .hero3-tile{position:relative;display:flex;flex-direction:column;gap:.7rem;min-height:118px;padding:1rem;border-radius:20px 20px 20px 4px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);transition:.2s ease;}
  .hero3-tile:hover{background:#fff;transform:translateY(-4px) rotate(-1deg);}
  .hero3-tile span{display:grid;place-items:center;width:26px;height:26px;border-radius:50%;background:var(--gold);color:var(--ink);font-family:'Bricolage Grotesque',sans-serif;font-size:.75rem;font-weight:800;}
  .hero3-tile strong{font-family:'Bricolage Grotesque',sans-serif;font-size:.8rem;line-height:1.35;font-weight:600;color:#fff;}
  .hero3-tile:hover strong{color:var(--ink);}
  .hero3-wave{position:absolute;left:0;bottom:-1px;width:100%;height:60px;}
  @media(max-width:1100px){.hero3-strip{grid-template-columns:repeat(4,1fr);}}
  @media(max-width:900px){.hero3-grid{grid-template-columns:1fr;}.hero3-art{max-width:300px;}}
  @media(max-width:640px){.hero3-strip{grid-template-columns:repeat(2,1fr);margin-top:2.5rem;}.hero3-tile{min-height:100px;}.chip-b{right:0;}.chip-a{left:0;}}
  /* COMMON */
  .section-white{background:#fff;} .section-soft{background:var(--soft);}
  .section-eyebrow{display:inline-flex;align-items:center;gap:.6rem;margin:0;padding:.4rem .9rem;border-radius:999px;background:var(--teal-tint);font-size:.82rem;font-weight:700;color:var(--teal);}
  .overview{position:relative;overflow:hidden;}
  .overview::before{content:"";position:absolute;width:340px;height:340px;right:-120px;top:-120px;border-radius:50%;border:38px solid var(--leaf-soft);}
