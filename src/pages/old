<script>
  const scrollToTopButton = document.getElementById("scrollToTop");

  window.addEventListener("scroll", () => {
    const shouldShow = window.scrollY > 400;

    scrollToTopButton.classList.toggle("opacity-0", !shouldShow);
    scrollToTopButton.classList.toggle("translate-y-4", !shouldShow);
    scrollToTopButton.classList.toggle("pointer-events-none", !shouldShow);

    scrollToTopButton.classList.toggle("opacity-100", shouldShow);
    scrollToTopButton.classList.toggle("translate-y-0", shouldShow);
    scrollToTopButton.classList.toggle("pointer-events-auto", shouldShow);
  });

  scrollToTopButton.addEventListener("click", () => {
    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  });
</script>
<script is:inline>
  const revealEls = document.querySelectorAll('.reveal');
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if(entry.isIntersecting){
        entry.target.style.animationPlayState = 'running';
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: .12 });
  revealEls.forEach((el) => {
    el.style.animationPlayState = 'paused';
    revealObserver.observe(el);
  });
  const countdownTarget = new Date("2026-09-30T09:00:00+05:30").getTime();
  function updateCountdown(){
    let diff = countdownTarget - Date.now();
    if(diff < 0){
      diff = 0;
    }
    const days = Math.floor(diff / 86400000);
    const hours = Math.floor((diff % 86400000) / 3600000);
    const minutes = Math.floor((diff % 3600000) / 60000);
    const seconds = Math.floor((diff % 60000) / 1000);
    const pad = (value) => String(value).padStart(2,'0');
    const dayEl = document.getElementById('cd-days');
    const hourEl = document.getElementById('cd-hours');
    const minuteEl = document.getElementById('cd-mins');
    const secondEl = document.getElementById('cd-secs');
    if(dayEl) dayEl.textContent = pad(days);
    if(hourEl) hourEl.textContent = pad(hours);
    if(minuteEl) minuteEl.textContent = pad(minutes);
    if(secondEl) secondEl.textContent = pad(seconds);
  }
  updateCountdown();
  setInterval(updateCountdown, 1000);
  const mobileMenuButton = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  mobileMenuButton?.addEventListener('click', () => {
    mobileMenuButton.classList.toggle('active');
    mobileMenu?.classList.toggle('open');
  });
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenuButton?.classList.remove('active');
      mobileMenu?.classList.remove('open');
    });
  });
  document.querySelectorAll('.lang-btn').forEach((button) => {
    button.addEventListener('click', () => {
      const lang = button.getAttribute('data-lang');
      document.querySelectorAll('.lang-btn').forEach((item) => {
        item.classList.toggle('active', item.getAttribute('data-lang') === lang);
      });
    });
  });
  const initiativeData = {
    sep: {
      // number: "Initiative 01",
      badge: "12-week programme",
      icon: "🚀",
      theme: "blue",
      title: "Social Entrepreneurship Programme (SEP)",
      body: `
        <p>The conclave will launch the <strong>Social Entrepreneurship Programme (SEP)</strong>, an initiative designed to build a strong and enabling ecosystem for social enterprises in Kerala. It supports purpose-driven entrepreneurs in transforming social and environmental challenges into innovative, sustainable and scalable solutions.</p>
        <p>SEP aims to position Kerala as a leading destination for social enterprises by enabling access to infrastructure, government support, funding, market opportunities, industry–academia linkages and other ecosystem resources.</p>
        <div class="modal-feature"><span>✦</span><p>By connecting ideas with opportunities and purpose with scale, SEP will empower social enterprises to create lasting impact, strengthen communities and build home-grown global brands from Kerala.</p></div>
      `
    },
    women: {
      // number: "Initiative 02",
      badge: "First in Kerala",
      icon: "👩🏽‍💼",
      theme: "orange",
      title: "Empowering Women Entrepreneurs",
      body: `
        <p>A key highlight of the conclave will be the launch of <strong>Kerala's first Women Startup Cell</strong> and the <strong>Women Startup Handbook</strong>.</p>
        <div class="modal-feature"><span>✦</span><p>The Women Startup Cell will serve as a single point of access for women entrepreneurs seeking information on startup support, KSUM schemes, mentorship, incubation and co-working spaces, labs, and other ecosystem resources.</p></div>
      `
    },
    literacy: {
      // number: "Initiative 03",
      badge: "Malayalam outreach",
      icon: "📣",
      theme: "green",
      title: "Taking Startup Literacy Across Kerala",
      body: `
        <p>KSUM is expanding women-focused startup initiatives across <strong>Tier 2 and Tier 3 regions</strong> through <strong>Startup Literacy Campaigns in Malayalam</strong>.</p>
        <div class="modal-feature"><span>✦</span><p>The conclave will mark the launch of the first edition of the Startup Literacy Campaign, bringing startup awareness, knowledge, and opportunities closer to aspiring entrepreneurs across Kerala.</p></div>
      `
    }
  };
  const initiativeModal = document.getElementById('initiative-modal');
  const initiativeDialog = document.getElementById('initiative-modal-dialog');
  const initiativeModalNumber = document.getElementById('initiative-modal-number');
  const initiativeModalBadge = document.getElementById('initiative-modal-badge');
  const initiativeModalIcon = document.getElementById('initiative-modal-icon');
  const initiativeModalTitle = document.getElementById('initiative-modal-title');
  const initiativeModalBody = document.getElementById('initiative-modal-body');
  let lastModalFocus = null;
  function openInitiativeModal(key){
    const data = initiativeData[key];
    if(!data || !initiativeModal) return;
    lastModalFocus = document.activeElement;
    if(initiativeModalNumber) initiativeModalNumber.textContent = data.number;
    if(initiativeModalBadge) initiativeModalBadge.textContent = data.badge;
    if(initiativeModalIcon) initiativeModalIcon.textContent = data.icon;
    if(initiativeModalTitle) initiativeModalTitle.textContent = data.title;
    if(initiativeModalBody) initiativeModalBody.innerHTML = data.body;
    initiativeModal.classList.remove('theme-blue','theme-orange','theme-green');
    initiativeModal.classList.add(`theme-${data.theme}`);
    initiativeModal.classList.add('is-open');
    initiativeModal.setAttribute('aria-hidden','false');
    document.body.classList.add('modal-open');
    requestAnimationFrame(() => {
      initiativeDialog?.focus();
    });
  }
  function closeInitiativeModal(){
    if(!initiativeModal) return;
    initiativeModal.classList.remove('is-open');
    initiativeModal.setAttribute('aria-hidden','true');
    document.body.classList.remove('modal-open');
    if(lastModalFocus instanceof HTMLElement){
      lastModalFocus.focus();
    }
  }
  document.querySelectorAll('[data-initiative-modal]').forEach((button) => {
    button.addEventListener('click', () => {
      const key = button.getAttribute('data-initiative-modal');
      if(key) openInitiativeModal(key);
    });
  });
  document.querySelectorAll('[data-modal-close]').forEach((button) => {
    button.addEventListener('click', closeInitiativeModal);
  });
  document.addEventListener('keydown', (event) => {
    if(event.key === 'Escape' && initiativeModal?.classList.contains('is-open')){
      closeInitiativeModal();
    }
  });
</script>
